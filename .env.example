# Divoom Times Gate
# Copy this file to .env and set values for your own device/session.
DIVOOM_IP=192.168.1.123
DIVOOM_MAC=
DIVOOM_AUTO_DISCOVER=1
DIVOOM_LCD_INDEX=4

# Refresh interval
REFRESH_SECONDS=300
STATE_REFRESH_SECONDS=15
DIVOOM_SKIP_UNCHANGED_PANELS=1
DIVOOM_VIEW_HOLD_SECONDS=0
METER_PROVIDER=both
CODEX_USAGE_WATCH=1
CENTER_PANEL=gif
SCREEN_1_PANEL=openai
SCREEN_2_PANEL=center
SCREEN_3_PANEL=status

# Claude usage API. Open claude.ai in your browser and inspect requests to find
# the organization id used in /api/organizations/<id>/usage.
CLAUDE_ORG_ID=
CLAUDE_USAGE_CACHE_SECONDS=3600
CLAUDE_USAGE_STALE_CACHE_SECONDS=86400

# Optional local GIF assets. These are intentionally local-only so the repo can
# stay generic and avoid bundling licensed/personal images.
OPENAI_LOGO_GIF_PATH=assets/openai-logo.gif
OPENAI_LOGO_ANIMATION=spin-on-wait
OPENAI_LOGO_SPIN_FRAMES=24
OPENAI_LOGO_SPIN_FRAME_MS=70
CENTER_GIF_PATH=assets/center.gif
STATUS_GIF_PATH=assets/status.gif

# Optional center screens:
# - CENTER_PANEL=ops shows markets, resources, and network ingress/egress.
# - CENTER_PANEL=health shows service health and Tailscale status.
MARKET_ASSETS=BTC:crypto:bitcoin,SOL:crypto:solana,USD:dolarapi:cripto
MARKET_CACHE_SECONDS=60
OPS_MARKET_ROWS=3
RESOURCE_PERCENT_BUCKET=5
RESOURCE_NETWORK_BUCKET_MBPS=0.25
# Optional CPU temperature command. On Apple Silicon, macmon is preferred:
# cargo install macmon
CPU_TEMP_COMMAND=macmon pipe -s 1 -i 1000
CPU_TEMP_MIN_C=30
CPU_TEMP_MAX_C=100

# Service health panel. Format: LABEL:http:URL, LABEL:tcp:host:port, or
# LABEL:cmd:/path/to/command --flag. Keep labels short for the 128x128 display.
HEALTH_CHECKS=WEB:http:http://localhost:3000,API:http:http://localhost:8000/health,DB:tcp:localhost:5432
HEALTH_MAX_CHECKS=5
HEALTH_TIMEOUT_SECONDS=1.5
TAILSCALE_HEALTH=1

# Optional calendar provider for future/alternate panels.
# CALENDAR_ICS_URL=
# CALENDAR_ICS_URL_1=
# CALENDAR_ICS_URL_2=
# CALENDAR_ICS_URL_3=
CALENDAR_MAX_EVENTS=3
# CALENDAR_CACHE_SECONDS=300
# CALENDAR_LOOKAHEAD_HOURS=48
CALENDAR_EVENT_ALERT_WINDOW_SECONDS=90
CALENDAR_EVENT_ALERT_MAX=3

# Interaction alerts. Auto flags read local Codex/Claude session logs and beep
# when a turn finishes and the app is waiting for operator input again.
CODEX_WAITING_AUTO=1
CLAUDE_WAITING_AUTO=1
BEEP_ON_CODEX_WAITING=1
BEEP_ON_CLAUDE_WAITING=1
BEEP_ON_LIMIT_ALERTS=1
BEEP_ON_CODEX_LIMIT_ALERTS=1
BEEP_ON_CLAUDE_LIMIT_ALERTS=1
BEEP_ON_CALENDAR_EVENTS=1
LIMIT_ZERO_AVAILABLE_PERCENT=0
DIVOOM_BEEP=1
DIVOOM_BEEP_TOTAL_MS=1800
DIVOOM_BEEP_ACTIVE_MS=300
DIVOOM_BEEP_OFF_MS=140
DIVOOM_BEEP_AFTER_PANEL_DELAY_MS=250
MAC_BEEP_FALLBACK=1
CODEX_WAITING_INPUT=0
CLAUDE_WAITING_INPUT=0

# Claude fallback manual values. Use these when browser scraping is not
# available. Values can be 0.72, 72, or 72%.
# CLAUDE_SESSION_PCT=72
# CLAUDE_WEEK_PCT=45
