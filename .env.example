# Divoom Times Gate
# Copy this file to .env and set values for your own device/session.
DIVOOM_IP=192.168.1.123
DIVOOM_MAC=
DIVOOM_AUTO_DISCOVER=1
DIVOOM_LCD_INDEX=4

# Refresh interval
REFRESH_SECONDS=300
STATE_REFRESH_SECONDS=15
DIVOOM_VIEW_HOLD_SECONDS=0
METER_PROVIDER=both

# Claude usage API. Open claude.ai in your browser and inspect requests to find
# the organization id used in /api/organizations/<id>/usage.
CLAUDE_ORG_ID=
CLAUDE_USAGE_CACHE_SECONDS=3600
CLAUDE_USAGE_STALE_CACHE_SECONDS=86400

# Optional local GIF assets. These are intentionally local-only so the repo can
# stay generic and avoid bundling licensed/personal images.
OPENAI_LOGO_GIF_PATH=assets/openai-logo.gif
GENGAR_GIF_PATH=assets/center.gif
CLAWD_GIF_PATH=assets/clawd.gif

# Interaction alerts. Auto flags read local Codex/Claude session logs and beep
# when a turn finishes and the app is waiting for operator input again.
CODEX_WAITING_AUTO=1
CLAUDE_WAITING_AUTO=1
BEEP_ON_CODEX_WAITING=1
BEEP_ON_CLAUDE_WAITING=1
DIVOOM_BEEP=1
DIVOOM_BEEP_TOTAL_MS=1200
DIVOOM_BEEP_ACTIVE_MS=200
DIVOOM_BEEP_OFF_MS=150
MAC_BEEP_FALLBACK=1
CODEX_WAITING_INPUT=0
CLAUDE_WAITING_INPUT=0

# Claude fallback manual values. Use these when browser scraping is not
# available. Values can be 0.72, 72, or 72%.
# CLAUDE_SESSION_PCT=72
# CLAUDE_WEEK_PCT=45
# CLAUDE_DESIGN_PCT=30
# CLAUDE_SONNET_PCT=47
